    "@fontsource/instrument-serif": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "docx": "^9.12.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.1",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.0",
    "vite": "^6.2.3"
