# Copy to .env.local for local dev; on Vercel set these in Project → Settings → Environment Variables. Never commit real values.

# Google sign-in (required: there is no guest mode). Same OAuth Web client ID in both. No client secret is used.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Server Gemini key for the no-key free tier (users may still add their own key for unlimited use).
GEMINI_API_KEY=""

# Owner Google Sheet via Apps Script (see docs/FEEDBACK_SETUP.md): Web app URL and the shared secret set in Script properties.
FEEDBACK_SCRIPT_URL=""
FEEDBACK_SECRET=""

# Owner email that may open /admin (server-checked against the verified Google ID token).
ADMIN_EMAIL="adv.akash2356@gmail.com"

# Optional GoatCounter site code ("off" disables counting).
VITE_GOATCOUNTER_CODE=""

# No-key free tier (server only, never sent to the browser).
# GEMINI_API_KEY above powers it. Fallback chain when Gemini is out of quota/busy/erroring: Groq free, then OpenRouter :free. Each is skipped when unset.
GROQ_API_KEY=""
# Optional Groq model (default openai/gpt-oss-120b).
GROQ_MODEL=""
OPENROUTER_API_KEY=""
# Optional comma list (max 3, only ids ending ":free" or "openrouter/free" are used).
OPENROUTER_MODELS=""
# Free AI results per signed-in account per UTC day, and a looser per-IP cap against account cycling.
FREE_AI_DAILY_CAP="3"
FREE_AI_DAILY_IP_CAP="15"
# Persistent cap counters: Upstash Redis free plan (or Vercel KV_REST_API_URL / KV_REST_API_TOKEN). Without these the cap is in-memory, best effort.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
